{
  "name": "personal-oura-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "4d4d9296bc8a4f2889cff2d46793c0ce" }
  ],
  "ratelimits": [
    {
      "name": "TOOL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "dev": { "port": 8788 }
}
